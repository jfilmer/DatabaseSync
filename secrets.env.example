# DatabaseSync secrets file — TEMPLATE. Copy to secrets.env and fill in real values.
#
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env          # REQUIRED on Unix — the service refuses to start otherwise
#
# secrets.env is gitignored. This .example file is tracked and must NEVER contain a real value.
#
# Supplies values for ${PLACEHOLDER} tokens in profiles/*.json connection strings, e.g.
#     "ConnectionString": "Host=prodpgsql.digsol.us;Port=8282;Database=emp;Username=empprod;Password=${DBSYNC_EMPPROD_PASSWORD}"
#
# Resolution order per placeholder (first hit wins):
#   1. Process environment variable of the same name
#   2. This file
# Prefer environment variables where the host supports them — systemd EnvironmentFile= on ubu2,
# the service environment on win2. This file is the fallback for hosts where that is awkward.
#
# Format: NAME=value, one per line. '#' starts a comment only at the START of a line, so a
# password may contain '#'. An optional "export " prefix is accepted so the file can also be
# sourced by a shell. Surrounding single or double quotes are stripped.
#
# AIM is the system of record for every value here (rule #115) — retrieve with
# `aim_get_config` using revealSecret. Each connection in a profile should also carry a
# "SecretRef" naming its AIM config id, so the pointer survives independently of this file.

# --- PostgreSQL: production (prodpgsql.digsol.us:8282) ---
DBSYNC_EMPPROD_PASSWORD=
DBSYNC_ACXPROD_PASSWORD=
DBSYNC_RMPPROD_PASSWORD=

# --- PostgreSQL: development (devpgsql.digsol.us:8282) ---
DBSYNC_EMPDEV_PASSWORD=
DBSYNC_ACXDEV_PASSWORD=
DBSYNC_RMPDEV_PASSWORD=

# --- SQL Server: LMPro (win2 host only, profiles 01-06) ---
DBSYNC_LMP_PRDSQL_PASSWORD=
DBSYNC_LMP_STGSQL_PASSWORD=
DBSYNC_LMP_NOLA1SQL_PASSWORD=
